{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  // Overriding `exclude` replaces expo/tsconfig.base's list rather than
  // extending it, so its entries are repeated here. supabase/functions is
  // Deno code (Edge Functions) with its own runtime and imports — Supabase
  // checks it at deploy time, not the app's tsc.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions"
  ]
}
