# Copy this file to .env and fill in real values.
# All client-exposed variables must be prefixed with EXPO_PUBLIC_ (Expo only
# inlines env vars with this prefix into the client bundle).
# See: https://docs.expo.dev/guides/environment-variables/

# Supabase project URL (Project Settings -> API -> Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://kegsnvhgdkwayvintbty.supabase.co

# Supabase anonymous/public API key (Project Settings -> API -> anon public key)
# Safe to expose to the client: access is governed by Row Level Security (RLS).
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_RfkxIXIGy4jwCnU-oVVFPA_9ozT-Lgs
